# Skill2Career AI — Environment Variables (TEMPLATE)
#
# Copy this file to `.env.local` and fill in your real values:
#   cp .env.example .env.local
#
# IMPORTANT:
# - Never commit `.env.local` or any file containing real credentials.
# - `.env*.local` is excluded via .gitignore.
# - Treat SUPABASE_SERVICE_ROLE_KEY, OPENAI_API_KEY, and GROQ_API_KEY as passwords.
# - Rotate them immediately if they are ever exposed.

# ──────────────────────────────────────────────
# Next.js
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ──────────────────────────────────────────────
# Supabase
# Get these from https://supabase.com/dashboard → Project Settings → API
# ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=placeholder
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# ──────────────────────────────────────────────
# AI Provider (Groq primary, OpenAI rollback)
#
# AI_PROVIDER switches the AI layer without code changes:
#   groq   → Groq (primary; requires GROQ_API_KEY)
#   openai → OpenAI (rollback / debugging; requires OPENAI_API_KEY)
# AI_MODEL optionally overrides the provider's default model
#   (groq default: openai/gpt-oss-20b, openai default: gpt-4o-mini).
# AI_FALLBACK_PROVIDER optionally names a second provider used for ONE
#   retry attempt when the active provider fails transiently (rate
#   limit, outage, timeout). Leave unset to disable fallback entirely.
#
# Get the Groq key from https://console.groq.com → API Keys.
# Both keys are server-side only — never prefix with NEXT_PUBLIC_.
# ──────────────────────────────────────────────
AI_PROVIDER=groq
GROQ_API_KEY=placeholder
# AI_MODEL=openai/gpt-oss-20b
# AI_FALLBACK_PROVIDER=openai
# GROQ_REASONING_EFFORT=low  # gpt-oss reasoning effort on Groq (low|medium|high).
#                               Low is correct for structured extraction: gpt-oss
#                               reasoning tokens count toward completion, and default
#                               (medium) effort can starve the JSON content or fail
#                               Groq's JSON validation.

# ──────────────────────────────────────────────
# OpenAI (rollback / optional fallback)
# Get from https://platform.openai.com/api-keys
# Only used server-side for AI resume analysis.
# ──────────────────────────────────────────────
OPENAI_API_KEY=placeholder

# ──────────────────────────────────────────────
# Scheduled cleanup (app/api/cron/cleanup/route.ts)
#
# Generate a random secret (e.g. `openssl rand -hex 32`) and set it here
# AND as a Production env var in Vercel. Vercel Cron automatically sends
# this same value as `Authorization: Bearer <secret>` on every scheduled
# invocation (see vercel.json) — the route refuses every request until
# this is set, so cleanup silently never runs without it.
# ──────────────────────────────────────────────
CRON_SECRET=placeholder
